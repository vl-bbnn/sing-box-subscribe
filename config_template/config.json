{
   "log": {
      "level": "info",
      "timestamp": true
   },
   "dns": {
      "servers": [
         {
            "tag": "local-dns",
            "address": "local",
            "detour": "direct-out"
         },
         {
            "tag": "cloudflare-dns",
            "address": "https://1.1.1.1/dns-query",
            "address_resolver": "local-dns",
            "detour": "handle"
         }
      ],
      "rules": [
         {
            "domain": "194.156.102.57",
            "server": "local-dns"
         },
         {
            "rule_set": "antizapret",
            "server": "cloudflare-dns"
         }
      ]
   },
   "inbounds": [
      {
         "type": "tun",
         "address": [
            "172.16.0.1/30"
         ],
         "auto_route": true,
         "strict_route": true,
         "sniff": true,
         "domain_strategy": "prefer_ipv4"
      }
   ],
   "outbounds": [
      {
         "type": "direct",
         "tag": "direct-out"
      },
      {
         "type": "dns",
         "tag": "dns-out"
      }
   ],
   "route": {
      "rules": [
         {
            "type": "logical",
            "mode": "and",
            "rules": [
               {
                  "rule_set": [
                     "antizapret",
                     "geosite-youtube",
                     "geosite-microsoft",
                     "geosite-discord",
                     "ip-antifilter_allyouneed",
                     "no-russia-hosts",
                     "discord-voice-ip-list"
                  ]
               },
               {
                  "rule_set": [
                     "geosite-reddit"
                  ],
                  "invert": true
               }
            ],
            "outbound": "handle"
         },
         {
            "rule_set": [
               "geosite-trackernetwork",
               "geosite-category-ads-all",
               "geosite-ads",
               "geosite-malware",
               "geoip-malware",
               "geosite-phishing",
               "geoip-phishing",
               "geosite-cryptominers",
               "geosite-category-public-tracker",
               "domain-oisd_big",
               "domain-adaway_alive_hosts_mail_fb",
               "domain-torrent_websites",
               "domain-torrent_trackres"
            ],
            "outbound": "block"
         },
         {
            "protocol": "dns",
            "outbound": "dns-out"
         }
      ],
      "rule_set": [
         {
            "type": "remote",
            "tag": "antizapret",
            "format": "binary",
